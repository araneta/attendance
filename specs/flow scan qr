🧪 Complete Test Script
bash#!/bin/bash

echo "=== Testing Attendance System ==="

# 1. Generate QR Code
echo -e "\n1️⃣  Generating QR Code..."
QR_RESPONSE=$(curl -s -X POST http://localhost:8080/api/qr/generate \
  -H "Content-Type: application/json" \
  -d '{"adminId": "admin1"}')

echo "Response: $QR_RESPONSE"

# Extract QR code
QR_CODE=$(echo $QR_RESPONSE | grep -o '"qrCode":"[^"]*"' | cut -d'"' -f4)
echo "QR Code: $QR_CODE"

# 2. Scan QR Code (User 1)
echo -e "\n2️⃣  User 1 scanning QR code..."
curl -s -X POST http://localhost:8080/api/qr/scan \
  -H "Content-Type: application/json" \
  -d "{\"qrCode\": \"$QR_CODE\", \"userId\": \"user1\"}" | jq .

# 3. Scan QR Code (User 2)
echo -e "\n3️⃣  User 2 scanning QR code..."
curl -s -X POST http://localhost:8080/api/qr/scan \
  -H "Content-Type: application/json" \
  -d "{\"qrCode\": \"$QR_CODE\", \"userId\": \"user2\"}" | jq .

# 4. Try invalid QR code
echo -e "\n4️⃣  Testing invalid QR code..."
curl -s -X POST http://localhost:8080/api/qr/scan \
  -H "Content-Type: application/json" \
  -d '{"qrCode": "invalid123", "userId": "user1"}' | jq .

echo -e "\n✅ Test complete!"
